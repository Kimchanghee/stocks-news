---
import '@fontsource-variable/source-serif-4/index.css';
import '@fontsource-variable/source-serif-4/wght-italic.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../styles/docket.css';
import { site } from '../site.config';
import data from '../data/companies.json';
import { fmtDate } from '../lib/sec';

export interface Crumb { name: string; path: string }
interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown>[];
  crumbs?: Crumb[];
  published?: string;
  modified?: string;
}
const { title, description, path, ogImage = '/og/home.png', ogType = 'website', jsonLd = [], crumbs = [], published, modified } = Astro.props;
const canonical = new URL(path, site.url).href;
const ogUrl = new URL(ogImage, site.url).href;
const orgId = `${site.url}/#org`;
const graph: Record<string, unknown>[] = [
  {
    '@type': 'Organization', '@id': orgId, name: site.name, alternateName: site.legalName, url: site.url + '/',
    email: site.contactEmail, description: site.description, logo: `${site.url}/favicon.svg`,
  },
  { '@type': 'WebSite', '@id': `${site.url}/#website`, url: site.url + '/', name: site.name, publisher: { '@id': orgId }, inLanguage: site.locale },
];
if (crumbs.length) {
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.path, site.url).href })),
  });
}
const ld = JSON.stringify({ '@context': 'https://schema.org', '@graph': [...graph, ...jsonLd] }).replace(/</g, '\\u003c');
const consentRegions = ['AT','BE','BG','HR','CY','CZ','DK','EE','FI','FR','DE','GR','HU','IS','IE','IT','LV','LI','LT','LU','MT','NL','NO','PL','PT','RO','SK','SI','ES','SE','GB','CH'];
const consentScript = `window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}
gtag('consent','default',{ad_storage:'denied',ad_user_data:'denied',ad_personalization:'denied',analytics_storage:'denied',region:${JSON.stringify(consentRegions)},wait_for_update:500});
gtag('consent','default',{ad_storage:'granted',ad_user_data:'granted',ad_personalization:'granted',analytics_storage:'granted',wait_for_update:500});`;
const gaScript = site.ga4Id ? `gtag('js',new Date());gtag('config',${JSON.stringify(site.ga4Id)});` : '';
const nav = [
  { href: '/', label: 'Docket' },
  { href: '/calendar/', label: 'Due dates' },
  { href: '/companies/', label: 'Companies' },
  { href: '/forms/', label: 'Forms' },
  { href: '/guides/', label: 'Guides' },
  { href: '/methodology/', label: 'Method' },
];
const current = Astro.url.pathname;
---
<!doctype html>
<html lang={site.lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <meta name="theme-color" content="#f4f1e8" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate" type="application/rss+xml" title={`${site.name} guides`} href="/feed.xml" />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content="en_US" />
  {published && <meta property="article:published_time" content={published} />}
  {modified && <meta property="article:modified_time" content={modified} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogUrl} />
  {site.gscVerification && <meta name="google-site-verification" content={site.gscVerification} />}
  <meta name="google-adsense-account" content={site.adsenseClient} />
  <script is:inline set:html={consentScript}></script>
  {site.ga4Id && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${site.ga4Id}`}></script>}
  {gaScript && <script is:inline set:html={gaScript}></script>}
  <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${site.adsenseClient}`} crossorigin="anonymous"></script>
  <script type="application/ld+json" set:html={ld}></script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="masthead">
    <div class="wrap">
      <div class="masthead__top">
        <span>stockmarketnews.online</span>
        <span>EDGAR snapshot <time datetime={data.asOf}>{fmtDate(data.asOf)}</time></span>
      </div>
      <div class="masthead__brand">
        <a class="masthead__name" href="/">The Filings Docket</a>
        <span class="masthead__sub">{site.tagline}: what large U.S. companies filed with the SEC, and what it means.</span>
      </div>
      <nav class="nav" aria-label="Primary">
        <ul>
          {nav.map((n) => (
            <li><a href={n.href} aria-current={(n.href === '/' ? current === '/' : current.startsWith(n.href)) ? 'page' : undefined}>{n.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </header>
  {crumbs.length > 1 && (
    <nav class="crumbs wrap" aria-label="Breadcrumb">
      <ol>
        {crumbs.map((c, i) => (<li>{i < crumbs.length - 1 ? <a href={c.path}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>))}
      </ol>
    </nav>
  )}
  <main id="main" class="wrap">
    <slot />
  </main>
  <footer class="footer">
    <div class="wrap">
      <div class="footer__grid">
        <div>
          <h2>About this docket</h2>
          <p>{site.description}</p>
          <p>Not investment advice. Filings are summarized for orientation only; the SEC document is the authoritative record. No AI-written news, no price predictions.</p>
          <p>Contact: <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a></p>
        </div>
        <div>
          <h2>Reference</h2>
          <ul>
            <li><a href="/forms/">Form explainers</a></li>
            <li><a href="/guides/">Guides</a></li>
            <li><a href="/calendar/">10-Q / 10-K due dates</a></li>
            <li><a href="/methodology/">Methodology &amp; sources</a></li>
            <li><a href="/feed.xml">RSS feed</a></li>
          </ul>
        </div>
        <div>
          <h2>The fine print</h2>
          <ul>
            <li><a href="/about/">About</a></li>
            <li><a href="/contact/">Contact</a></li>
            <li><a href="/privacy/">Privacy policy</a></li>
            <li><a href="/terms/">Terms of use</a></li>
            <li><a href="/disclaimer/">Disclaimer</a></li>
          </ul>
        </div>
      </div>
      <p class="footer__fine">Filing data: U.S. Securities and Exchange Commission EDGAR, retrieved <time datetime={data.asOf}>{fmtDate(data.asOf)}</time>. This site is independent and is not affiliated with or endorsed by the SEC. Ads may appear on this site; we do not use affiliate links.</p>
    </div>
  </footer>
  <script is:inline>
    document.addEventListener('click', function (e) {
      var a = e.target && e.target.closest ? e.target.closest('a[href^="http"]') : null;
      if (!a || !window.gtag) return;
      try { var u = new URL(a.href); if (u.host !== location.host) window.gtag('event', 'outbound_click', { destination_host: u.host, link_url: a.href }); } catch (_) {}
    });
  </script>
</body>
</html>
