---
// Plain document page (about, method, legal): caption + direct answer + prose. LD matches visible text.
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
import { fmtDate } from '../lib/sec';

interface Props {
  title: string; description: string; path: string; h1: string; kicker: string; answer: string;
  updated: string; ldType?: string; ogImage?: string; extraLd?: Record<string, unknown>[];
}
const { title, description, path, h1, kicker, answer, updated, ldType = 'WebPage', ogImage = '/og/site.png', extraLd = [] } = Astro.props;
const url = new URL(path, site.url).href;
const crumbs = [{ name: 'Docket', path: '/' }, { name: h1, path }];
const ld = [{ '@type': ldType, '@id': url + '#page', url, name: h1, description, dateModified: updated, inLanguage: site.locale, isPartOf: { '@id': `${site.url}/#website` }, about: { '@id': `${site.url}/#org` } }, ...extraLd];
---
<Base title={title} description={description} path={path} ogImage={ogImage} crumbs={crumbs} jsonLd={ld} modified={updated}>
  <section class="caption">
    <p class="caption__kicker">{kicker}</p>
    <h1>{h1}</h1>
    <p class="caption__meta">Updated <time datetime={updated}>{fmtDate(updated)}</time></p>
  </section>
  <div class="columns columns--wide">
    <article>
      <p class="answer" data-answer>{answer}</p>
      <div class="prose"><slot /></div>
    </article>
    <aside>
      <section class="aside-block">
        <h2>On the docket</h2>
        <p><a href="/">This week's filings</a>, the <a href="/calendar/">due-date calendar</a> and <a href="/forms/">form explainers</a>.</p>
      </section>
    </aside>
  </div>
</Base>
